rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Admins (Firebase custom claim `admin: true`, set by scripts/grant-admin.ts)
    // can read everything; the admin app (admin/) reads Firestore directly.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isOwner(data) {
      return isSignedIn() && (
        ('ownerId' in data && data.ownerId == request.auth.uid) ||
        ('owner_id' in data && data.owner_id == request.auth.uid)
      );
    }

    function isPodcastOwner(podcastId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/podcasts/$(podcastId)) &&
        isOwner(get(/databases/$(database)/documents/podcasts/$(podcastId)).data);
    }

    match /podcasts/{podcastId} {
      allow read: if isAdmin() || isOwner(resource.data);
      allow create: if false;
      allow update, delete: if false;

      match /episodes/{episodeId} {
        allow read: if isAdmin() || isPodcastOwner(podcastId);
        allow create: if false;
        allow update, delete: if false;
      }

      match /sources/{sourceId} {
        allow read: if isAdmin() || isPodcastOwner(podcastId);
        allow create: if false;
        allow update, delete: if false;
      }
    }
  }
}