# Firebase *web* app config (Firebase console > Project settings > Your apps).
# Not secret: it ships in the bundle. Copy to .env.local for `npm run dev`.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
# Optional; defaults to the API's named database.
VITE_FIRESTORE_DATABASE_ID=podcasts
