# Nothing is needed here for local dev: vite.config.ts reads the API's root .env
# (FIREBASE_WEB_API_KEY, FIREBASE_PROJECT_ID, FIRESTORE_DATABASE_ID, PORT).
# Copy to .env.local only to override a value; the auth domain defaults to
# <project>.firebaseapp.com. These are public web config, not secrets.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIRESTORE_DATABASE_ID=
